{
  "name": "flockfly-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "infra:test": "npm --prefix infra test",
    "infra:synth": "npm run build && npm --prefix infra run synth",
    "deploy:aws": "npm run build && npm --prefix infra run deploy",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@univerjs/core": "1.0.0-beta.2",
    "@univerjs/preset-docs-core": "1.0.0-beta.2",
    "@univerjs/preset-sheets-core": "1.0.0-beta.2",
    "@univerjs/presets": "1.0.0-beta.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rxjs": "^7.8.2",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.11"
  }
}
